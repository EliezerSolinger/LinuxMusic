@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix bufsz: <http://lv2plug.in/ns/ext/buf-size#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix opts: <http://lv2plug.in/ns/ext/options#> .
@prefix param: <http://lv2plug.in/ns/ext/parameters#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rsz: <http://lv2plug.in/ns/ext/resize-port#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix work: <http://lv2plug.in/ns/ext/worker#> .

<urn:linuxmusic:test:gain>
	a lv2:Plugin , lv2:AmplifierPlugin ;
	doap:name "LM Test Gain" ;
	doap:maintainer [ foaf:name "LinuxMusic tests" ] ;
	lv2:requiredFeature urid:map , opts:options , work:schedule ;
	lv2:optionalFeature lv2:hardRTCapable ;
	opts:requiredOption param:sampleRate , bufsz:maxBlockLength ;
	lv2:extensionData work:interface , state:interface ;
	lv2:port [
		a lv2:InputPort , lv2:AudioPort ;
		lv2:index 0 ;
		lv2:symbol "in" ;
		lv2:name "In"
	] , [
		a lv2:OutputPort , lv2:AudioPort ;
		lv2:index 1 ;
		lv2:symbol "out" ;
		lv2:name "Out"
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 2 ;
		lv2:symbol "gain" ;
		lv2:name "Gain" ;
		lv2:default 1.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 2.0 ;
		lv2:portProperty pprops:logarithmic
	] , [
		a lv2:OutputPort , lv2:ControlPort ;
		lv2:index 3 ;
		lv2:symbol "latency" ;
		lv2:name "Latency" ;
		lv2:portProperty lv2:reportsLatency , lv2:integer ;
		lv2:designation lv2:latency
	] , [
		a lv2:OutputPort , lv2:ControlPort ;
		lv2:index 4 ;
		lv2:symbol "rate" ;
		lv2:name "Sample rate seen"
	] , [
		a lv2:OutputPort , lv2:ControlPort ;
		lv2:index 5 ;
		lv2:symbol "max_block" ;
		lv2:name "Max block seen"
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 6 ;
		lv2:symbol "trigger" ;
		lv2:name "Trigger work" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:toggled
	] , [
		a lv2:OutputPort , lv2:ControlPort ;
		lv2:index 7 ;
		lv2:symbol "worked" ;
		lv2:name "Responses received"
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 8 ;
		lv2:symbol "report" ;
		lv2:name "Report id" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1000000 ;
		lv2:portProperty lv2:integer
	] , [
		a lv2:InputPort , lv2:ControlPort ;
		lv2:index 9 ;
		lv2:symbol "work_ms" ;
		lv2:name "Work duration" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 5000 ;
		lv2:portProperty lv2:integer
	] , [
		a lv2:OutputPort , lv2:ControlPort ;
		lv2:index 10 ;
		lv2:symbol "seed" ;
		lv2:name "State seed"
	] , [
		a lv2:InputPort , atom:AtomPort ;
		atom:bufferType atom:Sequence ;
		atom:supports midi:MidiEvent ;
		rsz:minimumSize 16384 ;
		lv2:index 11 ;
		lv2:symbol "midi_in" ;
		lv2:name "MIDI in"
	] , [
		a lv2:OutputPort , lv2:ControlPort ;
		lv2:index 12 ;
		lv2:symbol "notes" ;
		lv2:name "Notes seen"
	] , [
		a lv2:OutputPort , atom:AtomPort ;
		atom:bufferType atom:Sequence ;
		atom:supports midi:MidiEvent ;
		lv2:index 13 ;
		lv2:symbol "events_out" ;
		lv2:name "MIDI echo"
	] , [
		a lv2:OutputPort , lv2:ControlPort ;
		lv2:index 14 ;
		lv2:symbol "restored" ;
		lv2:name "Restored through the worker"
	] , [
		a lv2:OutputPort , lv2:ControlPort ;
		lv2:index 15 ;
		lv2:symbol "end_runs" ;
		lv2:name "end_run calls"
	] .

<urn:linuxmusic:test:unobtainium>
	a lv2:Plugin ;
	doap:name "LM Test Unobtainium" ;
	lv2:requiredFeature <urn:linuxmusic:test#unobtainium> , urid:map .

<urn:linuxmusic:test:refuses>
	a lv2:Plugin ;
	doap:name "LM Test Refuses" .

<urn:linuxmusic:test:stateless>
	a lv2:Plugin ;
	doap:name "LM Test Stateless" .
